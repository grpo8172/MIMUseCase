[
  {
    "policy_id": "EXEC-POLICY-UAT-ONLY",
    "service": "*",
    "allowed_environments": ["uat"],
    "allowed_action_types": ["uat_implementation_step"],
    "requires_human_approval": true,
    "execution_identity": "mim-executor-uat",
    "credential_ref": "secret-manager://mim-demo/uat/ansible-runner",
    "gke_cluster": "mim-demo-cluster",
    "gke_namespace": "mim-uat",
    "kubernetes_service_account": "mim-executor-ksa",
    "ansible_inventory": "inventories/uat.ini",
    "ansible_playbook": "playbooks/apply_approved_k8s_remediation.yml",
    "allowed_kubernetes_resources": ["deployment", "configmap", "pod"],
    "allowed_kubernetes_verbs": ["get", "list", "watch", "patch"],
    "notes": "MVP policy: only approved UAT implementation steps can execute."
  },
  {
    "policy_id": "EXEC-POLICY-SALESFORCE-UAT",
    "service": "Salesforce",
    "allowed_environments": ["uat"],
    "allowed_action_types": [
      "uat_read_only_check",
      "uat_configuration_update",
      "uat_validation",
      "approval_transition"
    ],
    "requires_human_approval": true,
    "execution_identity": "mim-executor-iam-uat",
    "credential_ref": "secret-manager://mim-demo/uat/iam-ansible-runner",
    "gke_cluster": "mim-demo-cluster",
    "gke_location": "australia-southeast1-a",
    "gke_namespace": "client-a-uat",
    "kubernetes_service_account": "mim-executor-ksa",
    "ansible_inventory": "inventories/uat.ini",
    "allowed_kubernetes_resources": [
      "deployment",
      "configmap",
      "pod"
    ],
    "allowed_kubernetes_verbs": [
      "get",
      "list",
      "watch",
      "patch"
    ],
    "preflight_playbook": "playbooks/ensure_remediation_capacity.yml",
    "action_adapters": {
      "uat-step-1": {
        "action_type": "uat_read_only_check",
        "ansible_playbook": "playbooks/salesforce/detect_certificate_drift.yml",
        "description": "Compare the approved IdP fingerprint with the active Salesforce-side fingerprint."
      },
      "uat-step-2": {
        "action_type": "uat_read_only_check",
        "ansible_playbook": "playbooks/salesforce/compare_saml_metadata.yml",
        "description": "Confirm that Salesforce-side SAML metadata is stale."
      },
      "uat-step-3": {
        "action_type": "uat_configuration_update",
        "ansible_playbook": "playbooks/salesforce/apply_uat_metadata.yml",
        "description": "Patch the Salesforce-side UAT metadata and restart the fake authentication deployment."
      },
      "uat-step-4": {
        "action_type": "uat_validation",
        "ansible_playbook": "playbooks/salesforce/validate_uat_remediation.yml",
        "description": "Validate rollout readiness and run the pilot-login demo check."
      },
      "uat-step-5": {
        "action_type": "approval_transition",
        "ansible_playbook": null,
        "description": "Record successful UAT validation and request production approval."
      }
    }
  }
]
